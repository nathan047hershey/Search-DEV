# Copy this file to `.env.local` on each machine, then fill in real values.
#   Windows:  copy .env.example .env.local
#   macOS/Linux: cp .env.example .env.local
# Never commit `.env.local`.

# --- Required for search ---
# GitHub Personal Access Tokens (comma-separated for higher rate limits)
# Create at: https://github.com/settings/tokens
# Required scopes: read:user, user:email
GITHUB_TOKEN=your_github_token_1,your_github_token_2

# --- Auth ---
# NextAuth (local)
NEXTAUTH_URL=http://localhost:3000
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=replace_with_long_random_string

# GitHub OAuth (optional - for GitHub login)
# Create at: https://github.com/settings/developers > New OAuth App
# Homepage URL: http://localhost:3000
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_ID=
GITHUB_SECRET=

# --- Database ---
# SQLite path (optional; defaults to data/app.db)
SQLITE_DB_PATH=./data/app.db

# --- Email (Resend) ---
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM=PivotalStacks Careers <careers@pivotalstacks.com>
RESEND_REPLY_TO=careers@pivotalstacks.com
# Verify SPF + DKIM + DMARC for your domain in Resend
EMAIL_SEND_GAP_MINUTES=10

# --- AI message generation (Minimax) ---
# https://platform.minimax.io
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_MODEL=MiniMax-M2.7
MINIMAX_BASE_URL=https://api.minimax.io/v1
# China region alternative: https://api.minimaxi.com/v1

# --- Optional email finder ---
# https://hunter.io/api
HUNTER_API_KEY=

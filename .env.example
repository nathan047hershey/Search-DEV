# GitHub Personal Access Tokens (comma-separated for unlimited usage)
# Each token gets 5,000 requests/hour
# Create at: https://github.com/settings/tokens
# Required scopes: read:user, user:email
GITHUB_TOKEN=your_github_token_1,your_github_token_2,your_github_token_3

# GitHub OAuth (Optional - for user login & favorites)
# Create at: https://github.com/settings/developers > New OAuth App
# Homepage URL: http://localhost:3000
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_with_node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# MongoDB Connection (Optional - for saving favorites)
MONGODB_URI=mongodb://localhost:27017/search-dev-github

# Minimax AI API (Optional - for AI-powered email finding)
# Get API key from Minimax
MINIMAX_API_KEY=your_minimax_api_key_here

# Hunter.io API (Optional - for professional email finding)
# Get free API key at: https://hunter.io/api (25 searches/month free)
HUNTER_API_KEY=your_hunter_api_key_here

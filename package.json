{
  "name": "search-dev-github",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "node -e \"const fs=require('fs'); if(!fs.existsSync('.env.local')&&fs.existsSync('.env.example')){fs.copyFileSync('.env.example','.env.local'); console.log('Created .env.local from .env.example');} else { console.log('.env.local ready'); }\"",
    "dev": "node node_modules/next/dist/bin/next dev -H 0.0.0.0 -p 3000",
    "dev:local": "node node_modules/next/dist/bin/next dev -H 127.0.0.1 -p 3000",
    "build": "node node_modules/next/dist/bin/next build",
    "start": "node node_modules/next/dist/bin/next start -H 0.0.0.0 -p 3000",
    "test": "tsx --test src/lib/*.test.ts",
    "typecheck": "tsc --noEmit",
    "pack": "powershell -ExecutionPolicy Bypass -File ./scripts/pack-for-transfer.ps1"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.10.0",
    "email-validator": "^2.0.4",
    "lucide-react": "^0.400.0",
    "next": "^16.3.3",
    "next-auth": "^4.24.11",
    "nodemailer": "^9.0.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "resend": "^3.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^18.2.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.23.13",
    "typescript": "^5.4.0"
  }
}
